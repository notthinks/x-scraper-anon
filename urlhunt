#!/usr/bin/env bash
# urlhunt — cari postingan X terbaru yang mengandung URL/token tertentu.
#
# Kenapa tidak pakai search X langsung: x.com/search me-redirect ke halaman
# login untuk pengunjung anonim. Kita pakai search engine publik (masih
# mengindeks status X) untuk menemukan ID tweet, lalu ambil isinya via DOM.
#
# Mode default AGRESIF: beberapa tab paralel, paginasi, rotasi profil.
# Pakai --calm untuk mode konservatif (1 tab, tanpa paginasi).
#
# Pemakaian:
# urlhunt "claude.ai/referral"
# urlhunt "claude.ai/referral" --limit 80 --tabs 6 --pages 3
# urlhunt "claude.ai/referral" --calm
# urlhunt "claude.ai/referral" --proxy "http://user:pass@host:80"
# urlhunt "openai.com" --out hasil.json
#
# Proxy juga bisa lewat env: URLHUNT_PROXY atau WEBSHARE_PROXY.
#
# Catatan: jangan dijalankan bertubi-tubi. Mesin pencari akan membalas
# 429 (Brave) atau 202 (DuckDuckGo) dan hasil jadi kosong sampai cooldown.
# Kalau IP WARP diblokir, pakai proxy (--proxy / URLHUNT_PROXY).
set -euo pipefail

REPO="$HOME/x-scraper-no-api"
PROFILE="$HOME/.xscraper/browser-profile"

# 0. Bersihkan sisa Chromium dari run sebelumnya.
#
# Ini WAJIB untuk pemakaian terjadwal: kalau satu run mati di tengah
# (timeout, kill, crash), proses Chromium-nya tertinggal memegang profil.
# Run berikutnya lalu gagal dengan "Opening in existing browser session"
# dan scraper berhenti total tanpa terlihat seperti error.
cleanup_stale() {
  local killed=0
  local pids
  pids=$(pgrep -f "user-data-dir=${PROFILE}" 2>/dev/null || true)
  if [ -n "$pids" ]; then
    for p in $pids; do
      kill -9 "$p" 2>/dev/null && killed=$((killed + 1))
    done
  fi
  # Kunci profil hanya aman dihapus kalau tidak ada proses yang hidup.
  if [ "$(pgrep -f "user-data-dir=${PROFILE}" 2>/dev/null | wc -l)" -eq 0 ]; then
    rm -f "$PROFILE"/Singleton* 2>/dev/null || true
  fi
  if [ "$killed" -gt 0 ]; then
    echo "[urlhunt] membersihkan $killed proses Chromium nyangkut" >&2
    sleep 1
  fi
}
cleanup_stale

# 1. Muat kredensial proxy (kalau ada). Proxy residensial dipakai untuk
# menembus blokir mesin pencari terhadap rentang IP WARP.
if [ -f "$HOME/.xscraper/proxy.env" ]; then
 # shellcheck disable=SC1091
 . "$HOME/.xscraper/proxy.env"
fi

# 2. Kalau proxy dikonfigurasi, cek dulu masih hidup.
#
# Proxy residensial punya kuota bandwidth. Kalau habis, webshare membalas
# HTTP 402 "Bandwidth limit reached" dan SEMUA navigasi gagal. Tanpa cek
# ini, scraper tampak "tidak ada hasil" padahal sebenarnya mati total.
if [ -n "${URLHUNT_PROXY:-}${WEBSHARE_PROXY:-}" ]; then
  PURL="${URLHUNT_PROXY:-$WEBSHARE_PROXY}"
  CODE=$(timeout 20 curl -s -x "$PURL" -o /dev/null -w "%{http_code}" \
    https://api.ipify.org 2>/dev/null) || CODE="000"
  if [ "$CODE" != "200" ]; then
    echo "[urlhunt] PERINGATAN: proxy balas HTTP $CODE (bukan 200)." >&2
    echo "[urlhunt] Kalau 402: kuota bandwidth proxy habis -> perbarui/tambah kuota." >&2
    echo "[urlhunt] Melepas proxy, kembali ke WARP untuk run ini." >&2
    unset URLHUNT_PROXY WEBSHARE_PROXY
  fi
fi

# 3. WARP wajib (IP datacenter -> X 403). Dilewati kalau pakai proxy,
# karena proxy sudah menggantikan peran WARP.
if [ -z "${URLHUNT_PROXY:-}${WEBSHARE_PROXY:-}" ]; then
  if ! warp-cli --accept-tos status 2>/dev/null | grep -q "Connected"; then
    echo "[urlhunt] menyalakan WARP…" >&2
    warp-cli --accept-tos mode warp >/dev/null 2>&1 || true
    warp-cli --accept-tos connect >/dev/null 2>&1 || true
    sleep 5
  fi
fi

# 4. Chromium headful di Xvfb (headless -> body kosong)
exec xvfb-run -a --server-args="-screen 0 1280x2000x24" \
  node "$REPO/src/urlhunt.js" "$@"
